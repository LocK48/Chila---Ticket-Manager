# Local development values only. Do not use these credentials in production.
POSTGRES_DB=chila
POSTGRES_USER=chila
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Used by the backend when allowing direct local browser requests.
CHILA_CORS_ALLOWED_ORIGIN=http://localhost:5173

# Generate a private 32-byte-or-longer Base64 secret for local development; never commit it.
CHILA_JWT_SECRET=replace-with-a-private-base64-secret
CHILA_JWT_ISSUER=chila-local
