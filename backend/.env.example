# Local development values only. Do not use these credentials in production.
POSTGRES_DB=chila
POSTGRES_USER=chila
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Optional: a Neon/PostgreSQL URL (postgresql://... or jdbc:postgresql://...).
# When set, it takes precedence over the local Compose database.
# POSTGRESQL_DB_URL=

# Used by the backend when allowing direct local browser requests.
CHILA_CORS_ALLOWED_ORIGIN=http://localhost:5173

# Generate a private 32-byte-or-longer Base64 secret for local development; never commit it.
CHILA_JWT_SECRET=replace-with-a-private-base64-secret
CHILA_JWT_ISSUER=chila-local

# SMTP settings are required for email verification during signup and password changes.
# Use credentials from your email provider; never commit real SMTP credentials.
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your-smtp-username
# SPRING_MAIL_PASSWORD=your-smtp-password
# CHILA_EMAIL_FROM=no-reply@example.com
